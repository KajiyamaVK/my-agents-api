meta {
  name: Scrape Dynamic
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/doc-scraper/scrape-dynamic
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "url": "https://visaoimoveisindaiatuba.com.br/venda/residencial_comercial/indaiatuba/",
    "mode": "dynamic",
    "scrollIterations": 5,
    "targetSelector": ".clb-search-result-property"
  }
}
